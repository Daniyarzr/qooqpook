# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qooq:qooq_secret@localhost:5432/qooq_vpn
DATABASE_URL_SYNC=postgresql://qooq:qooq_secret@localhost:5432/qooq_vpn

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram Bot ──────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_TELEGRAM_IDS=123456789,987654321

# ── Mini App & Hub ────────────────────────────────────────
WEBAPP_URL=https://app.qooqvpn.ru
ADMIN_URL=https://admin.qooqvpn.ru
HUB_DOMAIN=keys.qooqvpn.ru
API_BASE_URL=https://keys.qooqvpn.ru

# ── Admin Panel ───────────────────────────────────────────
ADMIN_SECRET_KEY=change-me-to-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_EXPIRE_HOURS=24

# ── VPN / Subscription ────────────────────────────────────
DEFAULT_SUBSCRIPTION_DAYS=30
REFERRAL_BONUS_PERCENT=10
REFERRAL_BONUS_DAYS=3
TRIAL_DAYS=3

# ── Xray node sync (per-user UUID on Reality inbound) ─────
XRAY_SYNC_ENABLED=false
XRAY_SSH_HOST=51.250.32.123
XRAY_SSH_PORT=22
XRAY_SSH_USER=adminka
XRAY_SSH_KEY_PATH=/root/.ssh/qooq_xray
XRAY_SSH_USE_SUDO=true
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_INBOUND_PORT=443
XRAY_RELOAD_COMMAND=systemctl restart xray
XRAY_STATS_ENABLED=false
XRAY_STATS_API=127.0.0.1:10085
XRAY_BIN_PATH=xray

# ── YooKassa (пополнение баланса) ─────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
DEPOSIT_AMOUNTS=100,300,500,1000,2000
DEPOSIT_MIN_AMOUNT=50
MAX_DEVICES_PER_SUBSCRIPTION=3
DEBUG=true
ENVIRONMENT=development
